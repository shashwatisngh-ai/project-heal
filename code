  <!-- ==========================================================================
       JAVASCRIPT LOGIC (100% VANILLA & TESTED)
       ========================================================================== -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. UPDATE DYNAMIC YEAR
      const yearEl = document.getElementById('currentYear');
      if (yearEl) yearEl.textContent = new Date().getFullYear();

      // ==========================================================================
      // 2. THEME TOGGLE (DARK / LIGHT WITH LOCALSTORAGE)
      // ==========================================================================
      const themeToggleBtn = document.getElementById('themeToggleBtn');
      const moonIcon = document.getElementById('moonIcon');
      const sunIcon = document.getElementById('sunIcon');
      
      const savedTheme = localStorage.getItem('heal_theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      applyTheme(savedTheme);

      function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('heal_theme', theme);
        if (theme === 'dark') {
          moonIcon.style.display = 'none';
          sunIcon.style.display = 'block';
        } else {
          moonIcon.style.display = 'block';
          sunIcon.style.display = 'none';
        }
      }

      themeToggleBtn.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
      });

      // ==========================================================================
      // 3. MOBILE MENU TOGGLE
      // ==========================================================================
      const mobileNavBtn = document.getElementById('mobileNavBtn');
      const mobileDrawer = document.getElementById('mobileDrawer');
      const menuIcon = document.getElementById('menuIcon');
      const closeIcon = document.getElementById('closeIcon');
      const mobileLinks = document.querySelectorAll('.mobile-link');

      function toggleMobileMenu(open) {
        const isOpen = open !== undefined ? open : !mobileDrawer.classList.contains('open');
        mobileDrawer.classList.toggle('open', isOpen);
        mobileNavBtn.setAttribute('aria-expanded', isOpen);
        menuIcon.style.display = isOpen ? 'none' : 'block';
        closeIcon.style.display = isOpen ? 'block' : 'none';
        document.body.style.overflow = isOpen ? 'hidden' : '';
      }

      mobileNavBtn.addEventListener('click', () => toggleMobileMenu());
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => toggleMobileMenu(false));
      });

      // ==========================================================================
      // 4. SCROLLSPY & SMOOTH SCROLLING
      // ==========================================================================
      const sections = document.querySelectorAll('main section[id]');
      const navLinks = document.querySelectorAll('.nav-link');
      const scrollTopBtn = document.getElementById('scrollTopBtn');

      window.addEventListener('scroll', () => {
        const scrollY = window.pageYOffset;
        
        // Scroll to top button visibility
        if (scrollY > 350) {
          scrollTopBtn.classList.add('visible');
        } else {
          scrollTopBtn.classList.remove('visible');
        }

        // Active link scrollspy
        let currentSectionId = '';
        sections.forEach(section => {
          const sectionTop = section.offsetTop - 120;
          const sectionHeight = section.offsetHeight;
          if (scrollY >= sectionTop && scrollY < sectionTop + sectionHeight) {
            currentSectionId = section.getAttribute('id');
          }
        });

        navLinks.forEach(link => {
          link.classList.remove('active');
          if (link.getAttribute('href') === `#${currentSectionId}`) {
            link.classList.add('active');
          }
        });
      }, { passive: true });

      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // ==========================================================================
      // 5. SOLUTIONS FILTERING
      // ==========================================================================
      const solutionTabs = document.querySelectorAll('.solutions-tabs .tab-btn');
      const solutionCards = document.querySelectorAll('.solution-card');

      solutionTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          solutionTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const filter = tab.getAttribute('data-filter');

          solutionCards.forEach(card => {
            if (filter === 'all' || card.getAttribute('data-category') === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // ==========================================================================
      // 6. WELL-BEING CORNER TABS
      // ==========================================================================
      const wbTabs = document.querySelectorAll('.wb-tab');
      const wbPanels = document.querySelectorAll('.wb-panel');

      wbTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          wbTabs.forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          wbPanels.forEach(p => p.classList.remove('active'));

          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          const targetId = tab.getAttribute('data-target');
          const targetPanel = document.getElementById(targetId);
          if (targetPanel) targetPanel.classList.add('active');
        });
      });

      // ==========================================================================
      // 7. MOOD TRACKER TOOL (LOCALSTORAGE PERSISTED)
      // ==========================================================================
      const moodButtons = document.querySelectorAll('.mood-btn');
      const moodFeedback = document.getElementById('moodFeedback');
      const feedbackEmoji = document.getElementById('feedbackEmoji');
      const feedbackTitle = document.getElementById('feedbackTitle');
      const feedbackText = document.getElementById('feedbackText');
      const moodHistoryList = document.getElementById('moodHistoryList');
      const btnClearMoods = document.getElementById('btnClearMoods');

      const MOOD_ADVICE = {
        'Calm': 'You are grounded. Take three deep breaths and carry this centered steadiness into your next instructional period.',
        'Energized': 'Use this positive vitality to engage students, but remember to preserve a reserve of energy for your evening personal rest.',
        'Content': 'Peace is valuable. Celebrate the lesson plans that worked and acknowledge your dedication to your students today.',
        'Overwhelmed': 'Your nervous system is signaling that demands exceed current capacity. Drop low-priority grading, step to the window, and take 4 slow breaths.',
        'Anxious': 'Inhale for 4 seconds, exhale for 8 seconds. This acute feeling will pass. Focus only on the immediate 10 minutes ahead.',
        'Exhausted': 'Rest is not a reward you earn; it is a biological requirement. Tonight, protect your sleep and leave all schoolwork at your desk.'
      };

      function renderMoodHistory() {
        const history = JSON.parse(localStorage.getItem('heal_mood_history') || '[]');
        moodHistoryList.innerHTML = '';
        if (history.length === 0) {
          moodHistoryList.innerHTML = '<span style="font-size:0.85rem; color:var(--text-muted);">No moods logged yet. Click any mood above!</span>';
          return;
        }

        history.slice(-8).reverse().forEach(entry => {
          const tag = document.createElement('div');
          tag.className = 'mood-history-tag';
          tag.innerHTML = `<span>${entry.emoji}</span> <strong>${entry.mood}</strong> <span style="font-size:0.75rem; color:var(--text-muted);">${entry.time}</span>`;
          moodHistoryList.appendChild(tag);
        });
      }

      moodButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          moodButtons.forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');

          const mood = btn.getAttribute('data-mood');
          const emoji = btn.getAttribute('data-emoji');
          
          feedbackEmoji.textContent = emoji;
          feedbackTitle.textContent = `You logged: ${mood}`;
          feedbackText.textContent = MOOD_ADVICE[mood] || 'Thank you for pausing to acknowledge your emotional state.';
          moodFeedback.classList.add('active');

          // Save to LocalStorage
          const history = JSON.parse(localStorage.getItem('heal_mood_history') || '[]');
          const now = new Date();
          const timeStr = `${now.toLocaleDateString(undefined, {month:'short', day:'numeric'})} ${now.toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit'})}`;
          history.push({ mood, emoji, time: timeStr });
          localStorage.setItem('heal_mood_history', JSON.stringify(history));
          renderMoodHistory();
        });
      });

      btnClearMoods.addEventListener('click', () => {
        if (confirm('Clear your local mood history log?')) {
          localStorage.removeItem('heal_mood_history');
          renderMoodHistory();
          moodButtons.forEach(b => b.classList.remove('selected'));
          moodFeedback.classList.remove('active');
        }
      });

      renderMoodHistory();

      // ==========================================================================
      // 8. BREATHING EXERCISE (START, PAUSE, RESET, MODES)
      // ==========================================================================
      const breathCircle = document.getElementById('breathCircle');
      const breathInstruction = document.getElementById('breathInstruction');
      const breathCountdown = document.getElementById('breathCountdown');
      const btnStartBreath = document.getElementById('btnStartBreath');
      const btnPauseBreath = document.getElementById('btnPauseBreath');
      const btnResetBreath = document.getElementById('btnResetBreath');
      const cycleBadge = document.getElementById('cycleBadge');
      const btnModeBox = document.getElementById('btnModeBox');
      const btnMode478 = document.getElementById('btnMode478');

      let currentPattern = '4-4-4-4'; // or '4-7-8'
      let breathInterval = null;
      let isBreathing = false;
      let phaseIndex = 0;
      let secondsLeft = 4;
      let completedCycles = 0;

      const PATTERNS = {
        '4-4-4-4': [
          { name: 'Inhale', duration: 4, className: 'inhale', instruction: 'Breathe In Slowly' },
          { name: 'Hold', duration: 4, className: 'hold', instruction: 'Gently Hold' },
          { name: 'Exhale', duration: 4, className: 'exhale', instruction: 'Release Outward' },
          { name: 'Rest', duration: 4, className: 'rest', instruction: 'Soft Rest' }
        ],
        '4-7-8': [
          { name: 'Inhale', duration: 4, className: 'inhale', instruction: 'Inhale through nose' },
          { name: 'Hold', duration: 7, className: 'hold', instruction: 'Hold breath peacefully' },
          { name: 'Exhale', duration: 8, className: 'exhale', instruction: 'Exhale through mouth' }
        ]
      };

      function updateBreathingUI() {
        const phases = PATTERNS[currentPattern];
        const currentPhase = phases[phaseIndex];
        
        breathInstruction.textContent = currentPhase.instruction;
        breathCountdown.textContent = secondsLeft;
        
        breathCircle.className = 'breathing-circle-inner ' + currentPhase.className;
      }

      function stepBreathing() {
        secondsLeft--;
        if (secondsLeft < 0) {
          const phases = PATTERNS[currentPattern];
          phaseIndex = (phaseIndex + 1) % phases.length;
          
          if (phaseIndex === 0) {
            completedCycles++;
            cycleBadge.innerHTML = `Cycles completed this session: <strong>${completedCycles}</strong>`;
          }
          secondsLeft = phases[phaseIndex].duration;
        }
        updateBreathingUI();
      }

      function startBreathing() {
        if (isBreathing) return;
        isBreathing = true;
        btnStartBreath.disabled = true;
        btnPauseBreath.disabled = false;
        
        const phases = PATTERNS[currentPattern];
        if (secondsLeft <= 0 || secondsLeft === phases[phaseIndex].duration) {
          secondsLeft = phases[phaseIndex].duration;
        }
        updateBreathingUI();
        breathInterval = setInterval(stepBreathing, 1000);
      }

      function pauseBreathing() {
        if (!isBreathing) return;
        isBreathing = false;
        clearInterval(breathInterval);
        btnStartBreath.disabled = false;
        btnPauseBreath.disabled = true;
        breathInstruction.textContent = 'Paused';
      }

      function resetBreathing() {
        isBreathing = false;
        clearInterval(breathInterval);
        phaseIndex = 0;
        const phases = PATTERNS[currentPattern];
        secondsLeft = phases[0].duration;
        btnStartBreath.disabled = false;
        btnPauseBreath.disabled = true;
        breathCircle.className = 'breathing-circle-inner rest';
        breathInstruction.textContent = 'Ready';
        breathCountdown.textContent = phases[0].duration;
      }

      btnStartBreath.addEventListener('click', startBreathing);
      btnPauseBreath.addEventListener('click', pauseBreathing);
      btnResetBreath.addEventListener('click', resetBreathing);

      btnModeBox.addEventListener('click', () => {
        btnModeBox.classList.add('active');
        btnMode478.classList.remove('active');
        currentPattern = '4-4-4-4';
        resetBreathing();
      });

      btnMode478.addEventListener('click', () => {
        btnMode478.classList.add('active');
        btnModeBox.classList.remove('active');
        currentPattern = '4-7-8';
        resetBreathing();
      });

      // ==========================================================================
      // 9. MICRO-JOURNAL TOOL (ADD, EDIT, DELETE, LOCALSTORAGE)
      // ==========================================================================
      const journalForm = document.getElementById('journalBody');
      const journalTitle = document.getElementById('journalTitle');
      const journalCategory = document.getElementById('journalCategory');
      const journalBody = document.getElementById('journalBody');
      const journalPromptSelect = document.getElementById('journalPromptSelect');
      const journalEditId = document.getElementById('journalEditId');
      const btnSaveJournal = document.getElementById('btnSaveJournal');
      const btnCancelJournalEdit = document.getElementById('btnCancelJournalEdit');
      const journalBtnText = document.getElementById('journalBtnText');
      const journalList = document.getElementById('journalList');
      const journalCount = document.getElementById('journalCount');
      const btnPreloadDemo = document.getElementById('btnPreloadDemo');

      const DEMO_ENTRIES = [
        {
          id: 'demo-1',
          title: 'Setting a boundary on evening email',
          category: 'Boundary',
          body: 'Decided today that I will not check student portal messages after 6:30 PM. The world will not crumble, and I deserve to sit with my family in peace.',
          date: 'Yesterday at 5:45 PM'
        },
        {
          id: 'demo-2',
          title: 'A small breakthrough in 3rd period',
          category: 'Gratitude',
          body: 'Marcus, who had been completely withdrawn all week, finally engaged and completed his assignment. Reminded me why I chose this vocation.',
          date: '2 days ago'
        }
      ];

      function getSavedEntries() {
        const raw = localStorage.getItem('heal_journal_entries');
        if (!raw) {
          localStorage.setItem('heal_journal_entries', JSON.stringify(DEMO_ENTRIES));
          return DEMO_ENTRIES;
        }
        return JSON.parse(raw);
      }

      function saveEntries(entries) {
        localStorage.setItem('heal_journal_entries', JSON.stringify(entries));
        renderJournalEntries();
      }

      function renderJournalEntries() {
        const entries = getSavedEntries();
        journalCount.textContent = entries.length;
        journalList.innerHTML = '';

        if (entries.length === 0) {
          journalList.innerHTML = `
            <div style="text-align:center; padding: 2rem; color: var(--text-muted); background: var(--bg-muted); border-radius: var(--radius-md);">
              <p style="margin-bottom: 0.5rem;">No journal entries yet.</p>
              <span style="font-size:0.85rem;">Write your first reflection on the left or click "Load Sample Entries"!</span>
            </div>
          `;
          return;
        }

        entries.forEach(entry => {
          const card = document.createElement('div');
          card.className = 'journal-entry-card';
          card.innerHTML = `
            <div class="journal-entry-header">
              <h4>${escapeHtml(entry.title)}</h4>
              <span class="solution-badge" style="background:var(--primary-light); color:var(--primary);">${escapeHtml(entry.category)}</span>
            </div>
            <div class="journal-entry-meta">Logged: ${escapeHtml(entry.date)}</div>
            <p style="font-size: 0.92rem; margin-top: 0.5rem; white-space: pre-line;">${escapeHtml(entry.body)}</p>
            <div class="journal-entry-actions">
              <button class="action-btn" onclick="editJournalEntry('${entry.id}')">Edit</button>
              <button class="action-btn delete" onclick="deleteJournalEntry('${entry.id}')">Delete</button>
            </div>
          `;
          journalList.appendChild(card);
        });
      }

      function escapeHtml(str) {
        if (!str) return '';
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      journalPromptSelect.addEventListener('change', () => {
        if (journalPromptSelect.value) {
          journalBody.value = journalPromptSelect.value + '\n\n' + journalBody.value;
          journalBody.focus();
        }
      });

      btnSaveJournal.addEventListener('click', (e) => {
        e.preventDefault();
        const title = journalTitle.value.trim();
        const body = journalBody.value.trim();
        const category = journalCategory.value;
        const editId = journalEditId.value;

        if (!title || !body) {
          alert('Please provide both an entry title and reflection note.');
          return;
        }

        const entries = getSavedEntries();
        const now = new Date();
        const dateStr = now.toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });

        if (editId) {
          // Update existing
          const idx = entries.findIndex(e => e.id === editId);
          if (idx !== -1) {
            entries[idx].title = title;
            entries[idx].category = category;
            entries[idx].body = body;
            entries[idx].date = dateStr + ' (Edited)';
          }
          journalEditId.value = '';
          journalBtnText.textContent = 'Save Entry';
          btnCancelJournalEdit.style.display = 'none';
        } else {
          // Add new
          const newEntry = {
            id: 'entry-' + Date.now(),
            title,
            category,
            body,
            date: dateStr
          };
          entries.unshift(newEntry);
        }

        saveEntries(entries);
        journalTitle.value = '';
        journalBody.value = '';
        journalPromptSelect.value = '';
      });

      window.editJournalEntry = function(id) {
        const entries = getSavedEntries();
        const entry = entries.find(e => e.id === id);
        if (!entry) return;

        journalTitle.value = entry.title;
        journalCategory.value = entry.category;
        journalBody.value = entry.body;
        journalEditId.value = entry.id;

        journalBtnText.textContent = 'Update Entry';
        btnCancelJournalEdit.style.display = 'inline-block';
        journalTitle.focus();
      };

      window.deleteJournalEntry = function(id) {
        if (confirm('Are you sure you want to delete this journal entry?')) {
          let entries = getSavedEntries();
          entries = entries.filter(e => e.id !== id);
          saveEntries(entries);
        }
      };

      btnCancelJournalEdit.addEventListener('click', () => {
        journalEditId.value = '';
        journalTitle.value = '';
        journalBody.value = '';
        journalBtnText.textContent = 'Save Entry';
        btnCancelJournalEdit.style.display = 'none';
      });

      btnPreloadDemo.addEventListener('click', () => {
        saveEntries(DEMO_ENTRIES);
      });

      renderJournalEntries();

      // ==========================================================================
      // 10. STRESS & BURNOUT SELF-CHECK QUIZ
      // ==========================================================================
      const stressCheckForm = document.getElementById('stressCheckForm');
      const quizResultBox = document.getElementById('quizResultBox');
      const quizScoreDisplay = document.getElementById('quizScoreDisplay');
      const quizTitleDisplay = document.getElementById('quizTitleDisplay');
      const quizDescDisplay = document.getElementById('quizDescDisplay');
      const quizLevelBadge = document.getElementById('quizLevelBadge');
      const quizActionPlan = document.getElementById('quizActionPlan');
      const btnRetakeQuiz = document.getElementById('btnRetakeQuiz');

      stressCheckForm.addEventListener('submit', (e) => {
        e.preventDefault();
        
        let totalScore = 0;
        let answeredCount = 0;

        for (let i = 1; i <= 5; i++) {
          const selected = stressCheckForm.querySelector(`input[name="q${i}"]:checked`);
          if (selected) {
            totalScore += parseInt(selected.value, 10);
            answeredCount++;
          }
        }

        if (answeredCount < 5) {
          alert('Please answer all 5 questions to receive your assessment.');
          return;
        }

        quizScoreDisplay.textContent = `${totalScore} / 15`;
        quizResultBox.classList.add('active');
        stressCheckForm.style.display = 'none';

        if (totalScore <= 4) {
          quizLevelBadge.textContent = 'Low / Balanced Stress';
          quizLevelBadge.className = 'pill-badge teal';
          quizTitleDisplay.textContent = 'Resilient Baseline';
          quizDescDisplay.textContent = 'You are currently managing educator work demands with stable boundaries. Continue maintaining routine decompression practices.';
          quizActionPlan.innerHTML = `
            <strong>Recommended Next Steps:</strong>
            <ul style="margin-top:0.5rem; padding-left:1.2rem;">
              <li>Maintain your current non-work evening cutoffs.</li>
              <li>Offer gentle support to a colleague who may be having an intense week.</li>
              <li>Practice 2-minute box breathing between tough class transitions.</li>
            </ul>
          `;
        } else if (totalScore <= 9) {
          quizLevelBadge.textContent = 'Moderate Stress Warning';
          quizLevelBadge.className = 'pill-badge';
          quizTitleDisplay.textContent = 'Elevated Chronic Load';
          quizDescDisplay.textContent = 'Your responses indicate noticeable weariness and unmanaged stressors. Without intentional pause points, this level frequently escalates to burnout.';
          quizActionPlan.innerHTML = `
            <strong>Targeted Recommendations:</strong>
            <ul style="margin-top:0.5rem; padding-left:1.2rem;">
              <li>Audit non-essential duties: decline uncompensated committees this semester.</li>
              <li>Speak with a trusted peer buddy to voice classroom frustrations confidentially.</li>
              <li>Strictly protect your lunch and prep periods from unauthorized coverages.</li>
            </ul>
          `;
        } else {
          quizLevelBadge.textContent = 'High Burnout Alert';
          quizLevelBadge.className = 'pill-badge';
          quizLevelBadge.style.backgroundColor = 'rgba(239, 68, 68, 0.15)';
          quizLevelBadge.style.color = '#ef4444';
          quizTitleDisplay.textContent = 'Severe Nervous System Strain';
          quizDescDisplay.textContent = 'Your symptoms reflect acute emotional exhaustion and workplace distress. This is not a personal failure—it is the result of unsustainable systemic overload.';
          quizActionPlan.innerHTML = `
            <strong>Immediate Protective Measures:</strong>
            <ul style="margin-top:0.5rem; padding-left:1.2rem;">
              <li>Consider taking an intentional personal/medical wellness day to physically sleep and reset.</li>
              <li>Consult an independent healthcare professional or therapist specializing in occupational burnout.</li>
              <li>If you feel in crisis or overwhelmed to the point of despair, reach out to the 988 Suicide & Crisis Lifeline immediately.</li>
            </ul>
          `;
        }

        quizResultBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });

      btnRetakeQuiz.addEventListener('click', () => {
        stressCheckForm.reset();
        stressCheckForm.style.display = 'block';
        quizResultBox.classList.remove('active');
      });

      // Quick check button in hero
      const btnQuickCheck = document.getElementById('btnQuickCheck');
      if (btnQuickCheck) {
        btnQuickCheck.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.querySelector('[data-target="tabQuiz"]');
          if (target) target.click();
          document.getElementById('wellbeing-corner').scrollIntoView({ behavior: 'smooth' });
        });
      }

      // ==========================================================================
      // 11. INTERACTIVE COMMUNITY POLL (REAL SURVEY RESULTS)
      // ==========================================================================
      const pollBtns = document.querySelectorAll('.poll-btn');
      const pollFeedback = document.getElementById('pollFeedback');

      pollBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          pollBtns.forEach(b => {
            b.classList.remove('btn-primary');
            b.classList.add('btn-outline');
          });
          btn.classList.remove('btn-outline');
          btn.classList.add('btn-primary');
          
          pollFeedback.style.display = 'block';
          localStorage.setItem('heal_community_vote', btn.getAttribute('data-vote'));
        });
      });

      // ==========================================================================
      // 12. ACCORDIONS (TAKE ACTION SECTION)
      // ==========================================================================
      const accordionItems = document.querySelectorAll('.accordion-item');

      accordionItems.forEach(item => {
        const btn = item.querySelector('.accordion-btn');
        const content = item.querySelector('.accordion-content');

        btn.addEventListener('click', () => {
          const isActive = item.classList.contains('active');

          accordionItems.forEach(i => {
            i.classList.remove('active');
            i.querySelector('.accordion-btn').setAttribute('aria-expanded', 'false');
            i.querySelector('.accordion-content').style.maxHeight = null;
          });

          if (!isActive) {
            item.classList.add('active');
            btn.setAttribute('aria-expanded', 'true');
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        });
      });

      // ==========================================================================
      // 13. CONTACT FORM VALIDATION & MODAL (REQUIREMENT 3 & 5)
      // ==========================================================================
      const contactForm = document.getElementById('contactForm');
      const contactName = document.getElementById('contactName');
      const contactEmail = document.getElementById('contactEmail');
      const contactRole = document.getElementById('contactRole');
      const contactSubject = document.getElementById('contactSubject');
      const contactMessage = document.getElementById('contactMessage');
      const contactDemoModal = document.getElementById('contactDemoModal');
      const modalSummary = document.getElementById('modalSummary');
      const btnCloseModal = document.getElementById('btnCloseModal');
      const btnOpenMailClient = document.getElementById('btnOpenMailClient');

      function validateEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      }

      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        let isValid = true;

        // Reset errors
        document.querySelectorAll('.field-error').forEach(el => el.style.display = 'none');

        // Name
        if (contactName.value.trim().length < 2) {
          document.getElementById('nameError').style.display = 'block';
          isValid = false;
        }

        // Email
        if (!validateEmail(contactEmail.value.trim())) {
          document.getElementById('emailError').style.display = 'block';
          isValid = false;
        }

        // Subject
        if (contactSubject.value.trim().length < 2) {
          document.getElementById('subjectError').style.display = 'block';
          isValid = false;
        }

        // Message
        if (contactMessage.value.trim().length < 10) {
          document.getElementById('messageError').style.display = 'block';
          isValid = false;
        }

        if (!isValid) return;

        // Display transparent modal informing user of demo mode & payload
        modalSummary.innerHTML = `
          <div><strong>Sender:</strong> ${escapeHtml(contactName.value)} (${escapeHtml(contactEmail.value)})</div>
          <div><strong>Role:</strong> ${escapeHtml(contactRole.value)}</div>
          <div><strong>Subject:</strong> ${escapeHtml(contactSubject.value)}</div>
          <div style="margin-top:0.4rem; color:var(--text-secondary);"><strong>Message:</strong> "${escapeHtml(contactMessage.value)}"</div>
        `;
        
        contactDemoModal.classList.add('active');
      });

      btnCloseModal.addEventListener('click', () => {
        contactDemoModal.classList.remove('active');
        contactForm.reset();
      });

      btnOpenMailClient.addEventListener('click', () => {
        const subject = encodeURIComponent(`[Project HEAL] ${contactSubject.value}`);
        const body = encodeURIComponent(`From: ${contactName.value} (${contactRole.value})\nEmail: ${contactEmail.value}\n\n${contactMessage.value}`);
        window.location.href = `mailto:contact@projectheal-educators.org?subject=${subject}&body=${body}`;
        contactDemoModal.classList.remove('active');
      });
    });
  </script>
</body>
</html>
