<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Project HEAL — Investigating why teachers lack real-time mental health support at work, raising systemic awareness, and offering interactive well-being tools.">
  <title>Project HEAL | Supporting Those Who Shape Our Future</title>
  
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    /* ==========================================================================
       1. CSS VARIABLES & THEME DEFINITIONS
       Calming palette: Deep Blues, Healing Teals, Pure Whites, Soft Lavenders
       ========================================================================== */
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --primary-light: #eff6ff;
      --primary-glow: rgba(37, 99, 235, 0.2);
      
      --teal: #0d9488;
      --teal-light: #f0fdfa;
      --teal-glow: rgba(13, 148, 136, 0.2);
      --teal-hover: #0f766e;
      
      --lavender: #8b5cf6;
      --lavender-light: #f5f3ff;
      --lavender-glow: rgba(139, 92, 246, 0.2);
      
      --sky: #0284c7;
      --accent: #f59e0b;
      --danger: #ef4444;
      --success: #10b981;
      
      /* Neutrals & Surfaces (Light Mode) */
      --bg-base: #f8fafc;
      --bg-surface: #ffffff;
      --bg-surface-elevated: #ffffff;
      --bg-muted: #f1f5f9;
      --bg-card: rgba(255, 255, 255, 0.92);
      
      --border-subtle: #e2e8f0;
      --border-focus: #94a3b8;
      
      --text-main: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --text-inverse: #ffffff;
      
      --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
      --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.08), 0 2px 6px -2px rgba(15, 23, 42, 0.04);
      --shadow-lg: 0 12px 28px -4px rgba(15, 23, 42, 0.12), 0 4px 12px -2px rgba(15, 23, 42, 0.06);
      --shadow-xl: 0 20px 40px -8px rgba(15, 23, 42, 0.16);
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-full: 9999px;
      
      --transition-fast: 0.18s ease;
      --transition-normal: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      --transition-slow: 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      
      --header-height: 74px;
      --container-max: 1240px;
    }

    [data-theme="dark"] {
      --primary: #3b82f6;
      --primary-hover: #60a5fa;
      --primary-light: rgba(59, 130, 246, 0.15);
      --primary-glow: rgba(59, 130, 246, 0.3);
      
      --teal: #14b8a6;
      --teal-light: rgba(20, 184, 166, 0.15);
      --teal-glow: rgba(20, 184, 166, 0.3);
      --teal-hover: #2dd4bf;
      
      --lavender: #a78bfa;
      --lavender-light: rgba(167, 139, 250, 0.15);
      --lavender-glow: rgba(167, 139, 250, 0.3);
      
      --bg-base: #090d16;
      --bg-surface: #111827;
      --bg-surface-elevated: #1f2937;
      --bg-muted: #1e293b;
      --bg-card: rgba(17, 24, 39, 0.88);
      
      --border-subtle: #2d3748;
      --border-focus: #4b5563;
      
      --text-main: #f8fafc;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --text-inverse: #0f172a;
      
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3);
      --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
      --shadow-lg: 0 12px 28px rgba(0, 0, 0, 0.5);
      --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    /* ==========================================================================
       2. RESET & BASE STYLES
       ========================================================================== */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-base);
      color: var(--text-main);
      line-height: 1.65;
      overflow-x: hidden;
      transition: background-color var(--transition-normal), color var(--transition-normal);
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 700;
      line-height: 1.25;
      color: var(--text-main);
      letter-spacing: -0.02em;
    }

    p {
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    a {
      color: var(--primary);
      text-decoration: none;
      transition: color var(--transition-fast);
    }

    a:hover {
      color: var(--primary-hover);
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    button {
      font-family: inherit;
      cursor: pointer;
      border: none;
      background: none;
      outline: none;
      transition: all var(--transition-fast);
    }

    /* Accessibility Focus styles */
    button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 3px;
    }

    /* Layout Utility */
    .container {
      width: 100%;
      max-width: var(--container-max);
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section {
      padding: 5.5rem 0;
      position: relative;
    }

    .section-alt {
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }

    .section-header {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 3.5rem auto;
    }

    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 1rem;
      font-size: 0.8125rem;
      font-weight: 600;
      border-radius: var(--radius-full);
      background-color: var(--primary-light);
      color: var(--primary);
      margin-bottom: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border: 1px solid rgba(37, 99, 235, 0.2);
    }

    .pill-badge.teal {
      background-color: var(--teal-light);
      color: var(--teal);
      border-color: rgba(13, 148, 136, 0.25);
    }

    .pill-badge.lavender {
      background-color: var(--lavender-light);
      color: var(--lavender);
      border-color: rgba(139, 92, 246, 0.25);
    }

    .section-title {
      font-size: clamp(2rem, 3.5vw, 2.75rem);
      margin-bottom: 1.1rem;
    }

    .section-subtitle {
      font-size: 1.125rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 1.65rem;
      border-radius: var(--radius-full);
      font-size: 0.975rem;
      font-weight: 600;
      white-space: nowrap;
      text-decoration: none;
      box-shadow: var(--shadow-sm);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, #1d4ed8 100%);
      color: #ffffff;
      box-shadow: 0 4px 14px var(--primary-glow);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--primary-glow);
      color: #ffffff;
    }

    .btn-teal {
      background: linear-gradient(135deg, var(--teal) 0%, #0f766e 100%);
      color: #ffffff;
      box-shadow: 0 4px 14px var(--teal-glow);
    }

    .btn-teal:hover {
      background: linear-gradient(135deg, #0f766e 0%, #115e59 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px var(--teal-glow);
      color: #ffffff;
    }

    .btn-outline {
      background-color: transparent;
      color: var(--text-main);
      border: 1.5px solid var(--border-subtle);
    }

    .btn-outline:hover {
      border-color: var(--primary);
      background-color: var(--primary-light);
      color: var(--primary);
      transform: translateY(-2px);
    }

    .btn-lavender {
      background: linear-gradient(135deg, var(--lavender) 0%, #7c3aed 100%);
      color: #ffffff;
      box-shadow: 0 4px 14px var(--lavender-glow);
    }

    .btn-lavender:hover {
      transform: translateY(-2px);
      color: #ffffff;
      box-shadow: 0 6px 20px var(--lavender-glow);
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }

    /* Cards */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 2rem;
      box-shadow: var(--shadow-sm);
      backdrop-filter: blur(8px);
      transition: all var(--transition-normal);
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(37, 99, 235, 0.3);
    }

    /* ==========================================================================
       3. NAVIGATION BAR (STICKY & RESPONSIVE)
       ========================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      height: var(--header-height);
      background-color: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-subtle);
      transition: background-color var(--transition-normal), border-color var(--transition-normal);
    }

    [data-theme="dark"] .site-header {
      background-color: rgba(17, 24, 39, 0.85);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 100%;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--text-main);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    .brand-logo svg {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }

    .brand-logo-image {
      display: block;
      width: 112px;
      height: 68px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .brand-badge {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: var(--radius-sm);
      background-color: var(--teal-light);
      color: var(--teal);
      border: 1px solid rgba(13, 148, 136, 0.2);
      margin-left: -0.25rem;
      text-transform: uppercase;
    }

    .nav-menu {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }

    .nav-link {
      font-size: 0.9125rem;
      font-weight: 500;
      color: var(--text-secondary);
      position: relative;
      padding: 0.35rem 0;
      transition: color var(--transition-fast);
    }

    .nav-link:hover, .nav-link.active {
      color: var(--primary);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 2px;
      background: linear-gradient(90deg, var(--primary), var(--teal));
      transition: width var(--transition-normal);
      border-radius: 2px;
    }

    .nav-link:hover::after, .nav-link.active::after {
      width: 100%;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .theme-toggle-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--bg-muted);
      color: var(--text-main);
      border: 1px solid var(--border-subtle);
      transition: transform var(--transition-fast), background-color var(--transition-fast);
    }

    .theme-toggle-btn:hover {
      transform: rotate(15deg) scale(1.05);
      background-color: var(--primary-light);
      color: var(--primary);
    }

    .crisis-pill-btn {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.5rem 1rem;
      font-size: 0.825rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      background: linear-gradient(135deg, #ef4444, #dc2626);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
      text-decoration: none;
      animation: pulse-border 2.5s infinite;
    }

    @keyframes pulse-border {
      0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
      50% { box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    }

    .crisis-pill-btn:hover {
      color: #ffffff;
      background: #dc2626;
      transform: translateY(-1px);
    }

    .mobile-nav-toggle {
      display: none;
      width: 42px;
      height: 42px;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-sm);
      background-color: var(--bg-muted);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
    }

    /* Mobile Drawer */
    .mobile-drawer {
      position: fixed;
      top: var(--header-height);
      left: 0;
      width: 100%;
      height: calc(100vh - var(--header-height));
      background-color: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      transform: translateY(-100%);
      opacity: 0;
      pointer-events: none;
      transition: transform var(--transition-normal), opacity var(--transition-normal);
      overflow-y: auto;
      z-index: 999;
    }

    .mobile-drawer.open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-nav-links {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      list-style: none;
    }

    .mobile-nav-links a {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--text-main);
      padding: 0.6rem 0;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    /* ==========================================================================
       4. HERO SECTION
       ========================================================================== */
    .hero-section {
      padding: 5rem 0 6rem 0;
      position: relative;
      background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.08), transparent 45%),
                  radial-gradient(circle at bottom left, rgba(13, 148, 136, 0.08), transparent 45%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
      align-items: center;
    }

    .hero-content {
      max-width: 650px;
    }

    .hero-tagline {
      font-size: 1rem;
      font-weight: 700;
      color: var(--teal);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-title {
      font-size: clamp(2.4rem, 4.2vw, 3.6rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      margin-bottom: 1.5rem;
    }

    .hero-title span.highlight {
      background: linear-gradient(135deg, var(--primary) 0%, var(--teal) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-desc {
      font-size: 1.2rem;
      color: var(--text-secondary);
      line-height: 1.7;
      margin-bottom: 2.25rem;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .hero-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-subtle);
    }

    .stat-item h4 {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 0.2rem;
    }

    .stat-item p {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 0;
      line-height: 1.35;
    }

    .hero-visual-card {
      position: relative;
    }

    .hero-img-wrapper {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-xl);
      border: 1px solid var(--border-subtle);
    }

    .hero-img-wrapper img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
      transition: transform var(--transition-slow);
    }

    .hero-img-wrapper:hover img {
      transform: scale(1.03);
    }

    .hero-floating-badge {
      position: absolute;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1rem 1.25rem;
      box-shadow: var(--shadow-lg);
      backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      max-width: 270px;
    }

    .hero-floating-badge.top-badge {
      top: -20px;
      left: -20px;
      animation: float-slow 4s ease-in-out infinite alternate;
    }

    .hero-floating-badge.bottom-badge {
      bottom: -20px;
      right: -20px;
      animation: float-slow 4s ease-in-out infinite alternate-reverse;
    }

    @keyframes float-slow {
      0% { transform: translateY(0); }
      100% { transform: translateY(-8px); }
    }

    .badge-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .badge-icon.blue { background-color: var(--primary-light); color: var(--primary); }
    .badge-icon.teal { background-color: var(--teal-light); color: var(--teal); }

    /* ==========================================================================
       5. THE PROBLEM SECTION
       ========================================================================== */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.75rem;
      margin-bottom: 3.5rem;
    }

    .problem-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 2.25rem;
      transition: all var(--transition-normal);
      display: flex;
      flex-direction: column;
    }

    .problem-card:hover {
      border-color: var(--primary);
      box-shadow: var(--shadow-lg);
      transform: translateY(-4px);
    }

    .problem-icon-box {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
      font-size: 1.5rem;
    }

    .problem-icon-box.red { background-color: rgba(239, 68, 68, 0.12); color: #ef4444; }
    .problem-icon-box.amber { background-color: rgba(245, 158, 11, 0.12); color: #f59e0b; }
    .problem-icon-box.purple { background-color: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
    .problem-icon-box.blue { background-color: rgba(37, 99, 235, 0.12); color: #2563eb; }
    .problem-icon-box.teal { background-color: rgba(13, 148, 136, 0.12); color: #0d9488; }
    .problem-icon-box.slate { background-color: rgba(100, 116, 139, 0.12); color: #64748b; }

    .problem-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .problem-card p {
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
      flex-grow: 1;
    }

    .problem-evidence-tag {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      background-color: var(--bg-muted);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-sm);
      display: inline-block;
      width: fit-content;
    }

    /* Day in the Life Interactive Comparison */
    .scenario-container {
      background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-muted) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      box-shadow: var(--shadow-md);
    }

    .scenario-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .timeline-steps {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      position: relative;
    }

    .timeline-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      position: relative;
    }

    .timeline-card .time-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--primary);
      text-transform: uppercase;
      margin-bottom: 0.5rem;
      display: block;
    }

    .timeline-card h4 {
      font-size: 1.05rem;
      margin-bottom: 0.5rem;
    }

    .timeline-card p {
      font-size: 0.875rem;
      margin-bottom: 0.5rem;
    }

    .timeline-card .stress-level {
      font-size: 0.75rem;
      font-weight: 600;
      color: #ef4444;
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    /* ==========================================================================
       6. IMPACT ON TEACHERS
       ========================================================================== */
    .impact-showcase {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: center;
    }

    .impact-cards-stack {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .impact-bar-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      transition: all var(--transition-normal);
    }

    .impact-bar-card:hover {
      border-color: var(--lavender);
      transform: translateX(6px);
    }

    .impact-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .impact-title-row h4 {
      font-size: 1.1rem;
    }

    .impact-pct {
      font-weight: 700;
      color: var(--lavender);
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background-color: var(--bg-muted);
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-bottom: 0.75rem;
    }

    .progress-fill {
      height: 100%;
      border-radius: var(--radius-full);
      background: linear-gradient(90deg, var(--lavender), var(--primary));
      transition: width 1.2s ease-in-out;
    }

    /* ==========================================================================
       7. WHY REAL-TIME SUPPORT MATTERS
       ========================================================================== */
    .comparison-table-wrapper {
      margin-top: 2.5rem;
      overflow-x: auto;
    }

    .comparison-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .comparison-column {
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      border: 1px solid var(--border-subtle);
    }

    .comparison-column.traditional {
      background: var(--bg-surface);
    }

    .comparison-column.realtime {
      background: linear-gradient(135deg, rgba(37, 99, 235, 0.05) 0%, rgba(13, 148, 136, 0.08) 100%);
      border-color: var(--teal);
      position: relative;
    }

    .col-header {
      margin-bottom: 2rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .col-header h3 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .feature-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .feature-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .feature-icon-bullet {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 0.15rem;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .feature-icon-bullet.negative {
      background-color: rgba(239, 68, 68, 0.15);
      color: #ef4444;
    }

    .feature-icon-bullet.positive {
      background-color: rgba(13, 148, 136, 0.2);
      color: var(--teal);
    }

    /* ==========================================================================
       8. SOLUTIONS SECTION
       ========================================================================== */
    .solutions-tabs {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }

    .tab-btn {
      padding: 0.65rem 1.4rem;
      border-radius: var(--radius-full);
      font-size: 0.95rem;
      font-weight: 600;
      background: var(--bg-surface);
      color: var(--text-secondary);
      border: 1px solid var(--border-subtle);
      transition: all var(--transition-fast);
    }

    .tab-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    .solutions-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2rem;
    }

    .solution-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 2.25rem;
      transition: all var(--transition-normal);
      display: flex;
      flex-direction: column;
    }

    .solution-card:hover {
      border-color: var(--teal);
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .solution-badge {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-sm);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }

    .solution-card h3 {
      font-size: 1.3rem;
      margin-bottom: 0.75rem;
    }

    .solution-card ul {
      margin-top: 1rem;
      padding-left: 1.25rem;
      color: var(--text-secondary);
      font-size: 0.925rem;
    }

    .solution-card li {
      margin-bottom: 0.5rem;
    }

    /* ==========================================================================
       9. INTERACTIVE WELL-BEING CORNER (FULL WORKING APPS)
       ========================================================================== */
    .wellbeing-container {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      box-shadow: var(--shadow-xl);
    }

    .wellbeing-nav {
      display: flex;
      gap: 0.5rem;
      border-bottom: 2px solid var(--border-subtle);
      padding-bottom: 1rem;
      margin-bottom: 2.5rem;
      overflow-x: auto;
    }

    .wb-tab {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text-secondary);
      background: transparent;
      white-space: nowrap;
      transition: all var(--transition-fast);
    }

    .wb-tab.active {
      background: var(--primary-light);
      color: var(--primary);
    }

    .wb-panel {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .wb-panel.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Tool 1: Mood Tracker */
    .mood-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 1rem;
      margin: 1.5rem 0 2rem 0;
    }

    .mood-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      padding: 1.25rem 0.75rem;
      background: var(--bg-muted);
      border: 2px solid transparent;
      border-radius: var(--radius-md);
      color: var(--text-main);
      transition: all var(--transition-fast);
    }

    .mood-btn:hover {
      background: var(--primary-light);
      border-color: var(--primary);
      transform: translateY(-3px);
    }

    .mood-btn.selected {
      background: var(--primary-light);
      border-color: var(--primary);
      box-shadow: 0 4px 12px var(--primary-glow);
    }

    .mood-btn .mood-emoji {
      font-size: 2.2rem;
    }

    .mood-btn .mood-name {
      font-size: 0.9rem;
      font-weight: 600;
    }

    .mood-feedback-box {
      background: linear-gradient(135deg, var(--teal-light), var(--primary-light));
      border: 1px solid rgba(13, 148, 136, 0.3);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      margin-bottom: 2rem;
      display: none;
    }

    .mood-feedback-box.active {
      display: block;
      animation: fadeIn 0.4s ease;
    }

    .mood-history-section {
      margin-top: 2rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-subtle);
    }

    .mood-history-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .mood-history-list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .mood-history-tag {
      background: var(--bg-muted);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      padding: 0.4rem 0.9rem;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    /* Tool 2: Breathing Exercise */
    .breathing-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 2rem 0;
    }

    .breathing-mode-select {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .breathing-circle-outer {
      width: 260px;
      height: 260px;
      border-radius: 50%;
      border: 3px dashed var(--teal);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      margin-bottom: 2.5rem;
      padding: 15px;
    }

    .breathing-circle-inner {
      width: 170px;
      height: 170px;
      border-radius: 50%;
      background: radial-gradient(circle, var(--teal) 0%, #0284c7 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      box-shadow: 0 0 35px var(--teal-glow);
      transition: transform 1s ease-in-out;
    }

    .breathing-circle-inner.inhale {
      transform: scale(1.35);
      background: radial-gradient(circle, #38bdf8 0%, var(--primary) 100%);
      box-shadow: 0 0 50px rgba(56, 189, 248, 0.45);
    }

    .breathing-circle-inner.hold {
      transform: scale(1.35);
      background: radial-gradient(circle, var(--lavender) 0%, #7c3aed 100%);
      box-shadow: 0 0 50px rgba(139, 92, 246, 0.45);
    }

    .breathing-circle-inner.exhale {
      transform: scale(0.85);
      background: radial-gradient(circle, var(--teal) 0%, #0f766e 100%);
      box-shadow: 0 0 25px var(--teal-glow);
    }

    .breathing-circle-inner.rest {
      transform: scale(1);
    }

    .breathing-instruction {
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      margin-bottom: 0.2rem;
    }

    .breathing-countdown {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1;
    }

    .breathing-controls {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .cycle-counter-badge {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-muted);
      background: var(--bg-muted);
      padding: 0.4rem 1rem;
      border-radius: var(--radius-full);
    }

    /* Tool 3: Micro-Journal */
    .journal-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .journal-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .form-group label {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .form-input, .form-textarea, .form-select {
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-main);
      font-family: inherit;
      font-size: 0.95rem;
      transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .form-input:focus, .form-textarea:focus, .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-glow);
      outline: none;
    }

    .journal-entries-container {
      max-height: 520px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-right: 0.5rem;
    }

    .journal-entry-card {
      background: var(--bg-muted);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      position: relative;
    }

    .journal-entry-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .journal-entry-header h4 {
      font-size: 1.05rem;
    }

    .journal-entry-meta {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .journal-entry-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
      justify-content: flex-end;
    }

    .action-btn {
      padding: 0.35rem 0.7rem;
      font-size: 0.785rem;
      font-weight: 600;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
      background: var(--bg-surface);
      color: var(--text-secondary);
    }

    .action-btn:hover {
      background: var(--primary-light);
      color: var(--primary);
    }

    .action-btn.delete:hover {
      background: rgba(239, 68, 68, 0.12);
      color: #ef4444;
      border-color: #ef4444;
    }

    .privacy-callout {
      background: var(--lavender-light);
      border-left: 4px solid var(--lavender);
      padding: 1rem 1.25rem;
      border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
      font-size: 0.85rem;
      color: var(--text-secondary);
      margin-top: 1.5rem;
    }

    /* Tool 4: Stress Self-Check */
    .quiz-container {
      max-width: 720px;
      margin: 0 auto;
    }

    .quiz-question-card {
      background: var(--bg-muted);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.75rem;
      margin-bottom: 1.5rem;
    }

    .quiz-question-title {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
    }

    .quiz-options-group {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.75rem;
    }

    .quiz-option-label {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0.85rem 0.5rem;
      background: var(--bg-surface);
      border: 1.5px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all var(--transition-fast);
    }

    .quiz-option-label:hover {
      border-color: var(--primary);
      background: var(--primary-light);
    }

    .quiz-option-input {
      display: none;
    }

    .quiz-option-input:checked + .quiz-option-label {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary);
      box-shadow: 0 0 0 2px var(--primary-glow);
    }

    .quiz-result-box {
      display: none;
      background: var(--bg-surface);
      border: 2px solid var(--primary);
      border-radius: var(--radius-md);
      padding: 2.25rem;
      margin-top: 2rem;
      text-align: center;
    }

    .quiz-result-box.active {
      display: block;
      animation: fadeIn 0.4s ease;
    }

    .score-badge {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--primary);
      margin: 0.5rem 0;
    }

    /* ==========================================================================
       10. RESEARCH & FINDINGS
       ========================================================================== */
    .research-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
      margin-bottom: 3.5rem;
    }

    .research-box {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 2rem;
    }

    .research-box h3 {
      font-size: 1.3rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .reference-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .reference-item {
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border-subtle);
    }

    .reference-item:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .reference-item h4 {
      font-size: 1rem;
      margin-bottom: 0.25rem;
    }

    .reference-item p {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 0.4rem;
    }

    /* Real Survey Results Interactive Simulator */
    .survey-data-box {
      background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-muted) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
    }

    .survey-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .survey-bars-stack {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .survey-bar-item .bar-label-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.925rem;
      font-weight: 600;
      margin-bottom: 0.4rem;
    }

    .survey-interactive-vote {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-subtle);
      text-align: center;
    }

    /* ==========================================================================
       11. TAKE ACTION
       ========================================================================== */
    .action-accordions {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      max-width: 860px;
      margin: 0 auto;
    }

    .accordion-item {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      overflow: hidden;
      transition: all var(--transition-normal);
    }

    .accordion-item.active {
      border-color: var(--teal);
      box-shadow: var(--shadow-md);
    }

    .accordion-btn {
      width: 100%;
      padding: 1.35rem 1.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-align: left;
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
      background: transparent;
    }

    .accordion-icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform var(--transition-normal);
    }

    .accordion-item.active .accordion-icon {
      transform: rotate(180deg);
    }

    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height var(--transition-normal);
      padding: 0 1.75rem;
    }

    .accordion-item.active .accordion-content {
      padding: 0 1.75rem 1.75rem 1.75rem;
    }

    .action-checklist {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .action-checklist li {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: 0.95rem;
      color: var(--text-secondary);
    }

    /* ==========================================================================
       12. ABOUT PROJECT HEAL
       ========================================================================== */
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
      align-items: center;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .pillar-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      transition: all var(--transition-fast);
    }

    .pillar-card:hover {
      border-color: var(--primary);
      transform: translateY(-3px);
    }

    .pillar-letter {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--primary);
      margin-bottom: 0.25rem;
    }

    /* ==========================================================================
       13. CONTACT & DISCLAIMER SECTION
       ========================================================================== */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: 3.5rem;
    }

    .contact-info-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }

    .emergency-box {
      background: rgba(239, 68, 68, 0.08);
      border: 1.5px solid rgba(239, 68, 68, 0.35);
      border-radius: var(--radius-md);
      padding: 1.25rem;
    }

    .emergency-box h4 {
      color: #ef4444;
      font-size: 1.05rem;
      margin-bottom: 0.4rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .form-status-alert {
      padding: 1rem 1.25rem;
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      display: none;
      margin-bottom: 1rem;
    }

    .form-status-alert.success {
      display: block;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.4);
      color: #065f46;
    }

    [data-theme="dark"] .form-status-alert.success {
      color: #34d399;
    }

    .form-status-alert.error {
      display: block;
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #991b1b;
    }

    [data-theme="dark"] .form-status-alert.error {
      color: #f87171;
    }

    /* ==========================================================================
       14. FOOTER & SCROLL TO TOP
       ========================================================================== */
    .site-footer {
      background: var(--bg-surface);
      border-top: 1px solid var(--border-subtle);
      padding: 4.5rem 0 2rem 0;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 3rem;
      margin-bottom: 3.5rem;
    }

    .footer-brand h3 {
      font-size: 1.4rem;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .footer-links-col h4 {
      font-size: 1rem;
      margin-bottom: 1.25rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .footer-links-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .footer-links-col a {
      color: var(--text-secondary);
      font-size: 0.9125rem;
    }

    .footer-links-col a:hover {
      color: var(--primary);
    }

